{
  "$note": "kwwk's corrections to pi-mono's catalog, laid over it by kwwk-generate-models. Objects merge key by key, other values replace, null removes. Say why and when beside each group.",
  "kimi-coding": {
    "$note": "kwwk speaks Anthropic Messages to Kimi's coding endpoint (registerKimiCoding pins anthropic-messages), so the Chat Completions wire pi-mono moved kimi-coding to on 2026-10-15 is held back here: base URL without /v1, Anthropic compat, no Chat Completions flags. That endpoint returns thinking with an empty signature and refuses a replay that drops it (kwwk #183, 2026-10-11); k3-256k and the k3.1-pro pair are priced, not free (the pair at Moonshot API's list price, 2026-10-24); the k3.1 pair takes k3's map, since models.dev lists the same efforts for both (low, high, max; 2026-10-24) and pi reads them only for its k3-style ids.",
    "k3-256k": {
      "api": "anthropic-messages",
      "baseUrl": "https://api.kimi.com/coding",
      "compat": {
        "$replace": true,
        "allowEmptySignature": true,
        "forceAdaptiveThinking": true
      },
      "thinkingLevelMap": {
        "$replace": true,
        "high": "high",
        "low": "low",
        "max": "max",
        "medium": null,
        "minimal": null,
        "off": null,
        "xhigh": null
      },
      "cost": {
        "input": 3,
        "output": 15,
        "cacheRead": 0.3
      }
    },
    "kimi-for-coding-highspeed": {
